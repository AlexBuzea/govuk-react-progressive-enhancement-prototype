{
  "name": "govuk-react-ssr-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GOV.UK-style React SSR prototype with progressive enhancement",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"tsx watch src/backend/index.ts\"",
    "build": "vite build",
    "start": "tsx src/backend/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.5.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "vite": "^6.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.1.2",
    "jsdom": "^27.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
