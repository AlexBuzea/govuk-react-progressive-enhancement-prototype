{
  "name": "govuk-react-ssr-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GOV.UK-style React SSR prototype with progressive enhancement",
  "scripts": {
    "build:client": "esbuild src/frontend/client.tsx --bundle --outfile=public/client.js --format=iife --sourcemap",
    "dev": "npm run build:client && tsx watch src/backend/index.ts",
    "start": "npm run build:client && tsx src/backend/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
