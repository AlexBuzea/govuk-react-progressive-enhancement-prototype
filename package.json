{
  "name": "govuk-react-ssr-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GOV.UK-style React SSR prototype with progressive enhancement",
  "scripts": {
    "build:islands": "vite build",
    "dev": "concurrently \"vite build --watch\" \"tsx watch src/backend/index.ts\"",
    "start": "vite build && tsx src/backend/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "govuk-frontend": "^6.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
